<header>
    <hgroup>
        <h1><i class="fa-solid fa-microchip"></i> PCBuilds</h1>
        <p>Magazin online cu piese pentru calculatoare.</p>
    </hgroup>

    <nav id="main-nav">
        <input type="checkbox" id="menu-toggle">
        
        <label for="menu-toggle" id="hamburger-menu">
            <span></span>
            <span></span>
            <span></span>
        </label>

        <ul class="meniu-principal">
            <li class="nav-item">
                <a href="/">
                    <i class="fa-solid fa-house"></i>
                    <span class="nav-text">Acasă</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="/#despre">
                    <i class="fa-solid fa-info-circle"></i>
                    <span class="nav-text">Despre Noi</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="/produse">
                    <i class="fa-solid fa-box-open"></i>
                    <span class="nav-text">Produse</span>
                </a>
                <ul class="submenu">
                    <li><a href="/produse">Toate (Afișează tot)</a></li>
                    
                    <% if (locals.categoriiMeniu) { %>
                        <% for (let cat of categoriiMeniu) { %>
                            <li>
                                <a style="text-transform: capitalize;" href="/produse?categorie=<%= cat %>">
                                    <%= cat.replaceAll('_', ' ') %>
                                </a>
                            </li>
                        <% } %>
                    <% } %>
                </ul>
            </li>
            <li class="nav-item">
                <a href="/#diverse">
                    <i class="fa-solid fa-book"></i>
                    <span class="nav-text">Ghid</span>
                </a>
                <ul class="submenu">
                    <li><a href="/#suport">Suport</a></li>
                    <li><a href="/#contact">Contact</a></li>
                </ul>
            </li>

            <li class="nav-item">
                <a href="/seturi">
                    <i class="fa-solid fa-layer-group"></i>
                    <span class="nav-text">Seturi Promoționale</span>
                </a>
            </li>
            <li class="nav-item d-flex align-items-center ms-lg-4 mt-3 mt-lg-0">
                <i class="fa-solid fa-palette" style="color: var(--accent-color); font-size: 1.2rem; margin-right: 8px;"></i>
                <label for="sel-tema" class="visually-hidden">Alege tema site-ului</label>
                <select id="sel-tema" class="form-select form-select-sm" style="width: auto; cursor: pointer; color: var(--text-color); background-color: var(--bg-color-alt); border: 1px solid var(--secondary-color);">
                    <option value="dark" style="color: #000;">🌙 Întunecat</option>
                    <option value="light" style="color: #000;">☀️ Luminos</option>
                    <option value="ocean" style="color: #000;">🌊 Ocean</option>
                    <option value="sepia" style="color: #000;">📜 Sepia</option>
                </select>
            </li>

            <li class="nav-item d-flex align-items-center ms-lg-3 mt-3 mt-lg-0">
                <button id="btn-orar" type="button" class="btn btn-sm btn-outline-warning" title="Vezi orarul de funcționare">
                    <i class="fa-solid fa-clock"></i> Orar
                </button>
            </li>

        </ul>
    </nav>

    <%- include('./orar') %>

    <% if (locals.oferta) { %>
        <div id="banner-oferta" class="alert alert-warning text-center m-0 border-0 rounded-0" style="background-color: var(--accent-color); color: #000; font-weight: bold; padding: 10px;">
            <i class="fa-solid fa-bolt"></i> OFERTĂ FULGER: Reducere de <%= oferta.reducere %>% la categoria <span style="text-transform: capitalize; text-decoration: underline;"><%= oferta.categorie.replace('_', ' ') %></span>!
            Expiră în: <span id="temporizator-oferta" class="badge bg-dark ms-2 fs-6">Calculare...</span>
        </div>

        <script>
            // --- Etapa 6, Bonus 12: Temporizator live care numara secunda cu secunda pana expira oferta ---
            const timpFinalizare = new Date("<%= oferta['data-finalizare'] %>").getTime();
            const elmTemporizator = document.getElementById("temporizator-oferta");
            const bannerOferta = document.getElementById("banner-oferta");

            const intervalOferta = setInterval(() => {
                let acum = new Date().getTime();
                let distanta = timpFinalizare - acum;

                if (distanta <= 0) {
                    clearInterval(intervalOferta);
                    elmTemporizator.innerHTML = "OFERTA A EXPIRAT!";
                    bannerOferta.style.backgroundColor = "#555";
                    bannerOferta.style.color = "#fff";
                    setTimeout(() => location.reload(), 2000); 
                    return;
                }

                let ore = Math.floor((distanta % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                let minute = Math.floor((distanta % (1000 * 60 * 60)) / (1000 * 60));
                let secunde = Math.floor((distanta % (1000 * 60)) / 1000);

                ore = (ore < 10) ? "0" + ore : ore;
                minute = (minute < 10) ? "0" + minute : minute;
                secunde = (secunde < 10) ? "0" + secunde : secunde;

                elmTemporizator.innerHTML = ore + "h " + minute + "m " + secunde + "s ";

                // --- Etapa 6, Bonus 12: Culoarea cronometrului devine roșie în ultimele 10 secunde (sub 10000ms) ---
                if (distanta < 10000) {
                    elmTemporizator.classList.remove('bg-dark');
                    elmTemporizator.classList.add('bg-danger');
                    bannerOferta.style.backgroundColor = "#ff4757"; 
                    bannerOferta.style.color = "white";
                }
            }, 1000);
        </script>
    <% } %>
</header>