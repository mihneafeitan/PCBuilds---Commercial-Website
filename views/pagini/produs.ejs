<!DOCTYPE html>
<html lang="ro">
<head>
    <title><%= prod.nume %> - PCBuilds</title>
    <%- include('../fragmente/head') %>
    <script src="/resurse/js/produs.js" defer></script>
</head>
<body id="top" style="background-color: var(--bg-color-main); color: var(--text-color);">
    <%- include('../fragmente/header') %>

    <main class="container my-5" style="padding: 2rem var(--page-padding);">
        
        <div class="mb-4">
            <a href="/produse" class="btn btn-outline-primary"><i class="fa-solid fa-arrow-left"></i> Înapoi la toate produsele</a>
        </div>

        <div class="row g-5 p-4 rounded shadow-lg" style="background-color: var(--bg-color-alt); border: 1px solid var(--secondary-color);">
            
            <div class="col-md-6 text-center d-flex align-items-center justify-content-center">
                <!-- BONUS 9 (Etapa 6): Imagini multiple - carusel cu imaginea principala + navigare -->
                <% let listaImagini = locals.imaginiProdus && imaginiProdus.length > 0 ? imaginiProdus : ['/resurse/imagini/' + prod.imagine]; %>
                <% if (listaImagini.length === 1) { %>
                    <img src="<%= listaImagini[0] %>" alt="<%= prod.nume %>" style="max-width: 100%; max-height: 400px; object-fit: contain; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.3);">
                <% } else { %>
                    <div id="caruselProdus" class="carousel slide w-100" data-bs-ride="false">
                        <div class="carousel-inner">
                            <% listaImagini.forEach(function(img, idx) { %>
                                <div class="carousel-item <%= idx === 0 ? 'active' : '' %>">
                                    <img src="<%= img %>" class="d-block mx-auto" alt="<%= prod.nume %> - imagine <%= idx + 1 %>" style="max-height: 400px; object-fit: contain; border-radius: 12px;">
                                </div>
                            <% }) %>
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#caruselProdus" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Anterioară</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#caruselProdus" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Următoare</span>
                        </button>
                        <div class="carousel-indicators" style="position: relative; margin-top: 10px;">
                            <% listaImagini.forEach(function(img, idx) { %>
                                <button type="button" data-bs-target="#caruselProdus" data-bs-slide-to="<%= idx %>" class="<%= idx === 0 ? 'active' : '' %>" style="background-color: var(--primary-color);"></button>
                            <% }) %>
                        </div>
                    </div>
                <% } %>
            </div>

            <div class="col-md-6">
                <h2 style="color: var(--primary-color); font-weight: bold; margin-bottom: 10px;"><%= prod.nume %></h2>
                
                <span class="badge <%= prod.nou ? 'bg-primary' : 'bg-secondary' %> mb-4 fs-6">
                    <%= prod.nou ? 'Produs Nou' : 'Resigilat / Refurbished' %>
                </span>

                <% /* BONUS 18 (Etapa 6): marcaj "NOU" daca produsul a fost adaugat recent pe site */ %>
                <% let esteNouPeSite = (new Date().getTime() - new Date(prod.data_adaugare).getTime()) <= locals.T_PRODUS_NOU_MS; %>
                <% if (esteNouPeSite) { %>
                    <span class="badge bg-warning text-dark mb-4 fs-6 ms-2">
                        <i class="fa-solid fa-star"></i> NOU PE SITE
                    </span>
                <% } %>

                <div class="mb-4 p-3 rounded" style="background-color: rgba(255,255,255,0.02); border-left: 4px solid var(--accent-color);">
                    <span style="font-size: 1.1rem; color: var(--text-color); opacity: 0.8;">Preț curent:</span>
                    <br>
                    <% if (locals.oferta && locals.oferta.categorie === prod.categorie) { %>
                        <% let pretRedus = prod.pret - (prod.pret * locals.oferta.reducere / 100); %>
                        <span class="fs-4 text-decoration-line-through text-secondary"><%= prod.pret %> RON</span>
                        <span class="fs-2 fw-bold text-success ms-2"><%= pretRedus.toFixed(2) %> RON</span>
                        <span class="badge bg-danger align-middle ms-2">REDUCERE -<%= locals.oferta.reducere %>%</span>
                    <% } else { %>
                        <span class="fs-2 fw-bold text-success"><%= prod.pret %> RON</span>
                    <% } %>
                </div>

                <!-- BONUS 20 (Etapa 6): buton "Compara" - enuntul cere sa existe si pe pagina
                     fiecarui produs, nu doar in tabelul de produse. Logica JS e in
                     resurse/js/comparare.js, incarcat global din head.ejs. -->
                <button class="btn btn-outline-info btn-comparare mb-3 w-100" data-id="<%= prod.id %>" data-nume="<%= prod.nume %>">
                    <i class="fa-solid fa-scale-balanced"></i> Compară
                </button>

                <!-- ETAPA 7 (animatie-banner): buton DEMO pentru cookie-ul "data ultimei cumparaturi".
                     Proiectul nu are inca un cos/checkout real - butonul asta doar demonstreaza
                     ca functionalitatea de cookie e implementata corect si poate fi inlocuit cu
                     apelul real catre un sistem de comenzi cand va exista. -->
                <button id="btn-simuleaza-cumparare" type="button" class="btn btn-outline-success mb-4 w-100">
                    <i class="fa-solid fa-cart-shopping"></i> Simulează cumpărare (demo, pt. cookie)
                </button>

                <!-- ETAPA 7 (bootstrap_js): Accordion pentru descriere si detalii, initial inchis -->
                <!-- Starea deschis/inchis a fiecarui panou se memoreaza in localStorage, in resurse/js/produs.js -->
                <div class="accordion" id="accordionProdus">

                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#acc-descriere" aria-expanded="false" aria-controls="acc-descriere">
                                <i class="fa-solid fa-align-left me-2"></i> Descrierea produsului
                            </button>
                        </h2>
                        <div id="acc-descriere" class="accordion-collapse collapse" data-bs-parent="#accordionProdus">
                            <div class="accordion-body" style="text-align: justify; line-height: 1.6;">
                                <%= prod.descriere %>
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#acc-specificatii" aria-expanded="false" aria-controls="acc-specificatii">
                                <i class="fa-solid fa-circle-info me-2"></i> Specificații tehnice
                            </button>
                        </h2>
                        <div id="acc-specificatii" class="accordion-collapse collapse" data-bs-parent="#accordionProdus">
                            <div class="accordion-body">
                                <table class="table table-dark table-striped table-bordered align-middle mb-0" style="font-size: 0.95rem;">
                                    <tbody>
                                        <tr>
                                            <td class="fw-bold text-primary" style="width: 35%;">Categorie componentă</td>
                                            <td style="text-transform: capitalize;"><%= prod.categorie.replace('_', ' ') %></td>
                                        </tr>
                                        <tr>
                                            <td class="fw-bold text-primary">Garanție comercială</td>
                                            <td><%= prod.garantie_luni %> luni (<%= Math.floor(prod.garantie_luni / 12) %> ani)</td>
                                        </tr>
                                        <tr>
                                            <td class="fw-bold text-primary">Culoare piesă</td>
                                            <td><%= prod.culoare %></td>
                                        </tr>
                                        <tr>
                                            <td class="fw-bold text-primary">Dată listare depozit</td>
                                            <td>
                                                <%
                                                    let dataRo = new Intl.DateTimeFormat('ro-RO', {
                                                        day: 'numeric', month: 'long', year: 'numeric'
                                                    }).format(new Date(prod.data_adaugare));
                                                %>
                                                <%= dataRo %>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#acc-compatibilitate" aria-expanded="false" aria-controls="acc-compatibilitate">
                                <i class="fa-solid fa-puzzle-piece me-2"></i> Compatibilitate
                            </button>
                        </h2>
                        <div id="acc-compatibilitate" class="accordion-collapse collapse" data-bs-parent="#accordionProdus">
                            <div class="accordion-body">
                                <% let pieseComp = prod.compatibilitate.split(','); %>
                                <% pieseComp.forEach(c => { %>
                                    <span class="badge bg-outline-info border border-info text-info me-1" style="font-size: 0.9em;"><%= c.trim() %></span>
                                <% }) %>
                            </div>
                        </div>
                    </div>

                </div>
        </div>
        </div>
    <div class="row mt-5">
        <div class="col-12">
            <h3 style="color: var(--accent-color); border-bottom: 2px solid var(--primary-color); padding-bottom: 10px; margin-bottom: 30px;">
                <i class="fa-solid fa-boxes-stacked"></i> Acest produs este disponibil și în pachetele:
            </h3>
                
            <% if (!seturi || seturi.length === 0) { %>
                <p class="text-muted">Produsul nu face parte din niciun set promoțional în acest moment.</p>
            <% } else { %>
                <div class="d-flex flex-wrap gap-4">
                    <% seturi.forEach(set => { %>
                        <div class="p-3 rounded shadow" style="background-color: var(--bg-color-alt); border: 1px dashed var(--primary-color); flex: 1; min-width: 300px;">
                            <h4 class="text-primary"><%= set.nume_set %></h4>
                            <p style="font-size: 0.9rem;"><%= set.descriere_set %></p>
                                
                            <div class="mb-3">
                                <span class="fs-4 fw-bold" style="color: #27ae60;"><%= set.infoPret.pretRedus %> RON</span>
                                <del class="text-secondary mx-2"><%= set.infoPret.pretIntreg %> RON</del>
                            </div>

                            <h6>Alte produse din set:</h6>
                            <div class="d-flex gap-2 overflow-auto py-2">
                                <% set.produse_set.forEach(p => { %>
                                    <a href="/produs/<%= p.id %>" title="<%= p.nume %>">
                                        <img src="/resurse/imagini/<%= p.imagine %>" alt="<%= p.nume %>" style="width: 50px; height: 50px; object-fit: cover; border-radius: 5px; border: 1px solid #ccc;">
                                    </a>
                                <% }) %>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </div>

    <!-- BONUS 16 (Etapa 6): Produse similare -->
    <div class="row mt-5">
        <div class="col-12">
            <h3 style="color: var(--accent-color); border-bottom: 2px solid var(--primary-color); padding-bottom: 10px; margin-bottom: 30px;">
                <i class="fa-solid fa-shapes"></i> Produse similare
            </h3>

            <% if (!locals.produseSimilare || produseSimilare.length === 0) { %>
                <p class="text-muted">Nu am găsit alte produse similare momentan.</p>
            <% } else { %>
                <div class="d-flex flex-wrap gap-4">
                    <% produseSimilare.forEach(function(p) { %>
                        <a href="/produs/<%= p.id %>" class="text-decoration-none" style="color: inherit; width: 180px;"> <!-- <- -->
                            <div class="p-3 rounded text-center h-100" style="background-color: var(--bg-color-alt); border: 1px solid var(--secondary-color);">
                                <img src="/resurse/imagini/<%= p.imagine %>" alt="<%= p.nume %>" style="width: 100%; height: 110px; object-fit: cover; border-radius: 8px; margin-bottom: 10px;">
                                <div style="font-weight: bold; font-size: 0.9rem; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;"><%= p.nume %></div>
                                <div style="color: var(--accent-color); font-weight: bold; margin-top: 6px;"><%= p.pret %> RON</div>
                                <div style="font-size: 0.8rem; opacity: 0.7;">Garanție: <%= p.garantie_luni %> luni</div>
                            </div>
                        </a>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </div>
    </main>

    <%- include('../fragmente/footer') %>
</body>
</html>