<!DOCTYPE html>
<html lang="ro">
<head>
    <title>Produse - PCBuilds</title>
    <%- include('../fragmente/head') %>
    <script src="/resurse/js/produse.js" defer></script>
</head>
<body id="top">
    <%- include('../fragmente/header') %>

    <main style="padding: 2rem var(--page-padding);">

        <h2 style="text-align:center; color: var(--accent-color); margin-bottom: 2rem;">Produsele Noastre</h2>

        <div class="text-start mb-3">
            <button id="btn-toggle-filtre" class="btn btn-outline-primary">
                <i class="fa-solid fa-eye-slash"></i> Ascunde Panoul de Filtre
            </button>
        </div>

        <%
            let culoriUnice = [...new Set(produse.map(p => p.culoare))];
            let garantiiUnice = [...new Set(produse.map(p => p.garantie_luni))].sort((a,b) => a - b);
            let compatibilitati = [];
            produse.forEach(p => {
                let comp = p.compatibilitate.split(',');
                comp.forEach(c => { if(!compatibilitati.includes(c.trim())) compatibilitati.push(c.trim()); });
            });
        %>

        <section id="filtre-produse" data-bs-theme="dark" class="container-fluid mb-4 p-4" style="background-color: var(--bg-color-alt); border-radius: 10px; border: 1px solid var(--primary-color);">
            <h4 class="mb-4" style="color: var(--primary-color);"><i class="fa-solid fa-filter"></i> Filtrează și Sortează</h4>
            
            <div class="row g-3">
                <div class="col-md-6 col-lg-3">
                    <label class="form-label">Nume produs (Cuvânt cheie)</label>
                    <input type="text" id="inp-nume" class="form-control" placeholder="ex: Intel, RTX...">
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="form-floating h-100">
                        <textarea class="form-control" id="inp-descriere" placeholder="Cuvânt în descriere" style="height: 100%;"></textarea>
                        <label for="inp-descriere">Căutare în descriere</label>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <label class="form-label">Culoare predominantă</label>
                    <select id="inp-culoare" class="form-select">
                        <option value="toate" selected>Toate culorile (Oricare)</option>
                        <% for (let c of culoriUnice) { %>
                            <option value="<%= c %>"><%= c %></option>
                        <% } %>
                    </select>
                </div>

                <div class="col-md-6 col-lg-3">
                    <label class="form-label">Garanție minimă (luni)</label>
                    <input class="form-control" list="lista-garantie" id="inp-garantie" placeholder="Selectează sau scrie...">
                    <datalist id="lista-garantie">
                        <% for (let g of garantiiUnice) { %>
                            <option value="<%= g %>"><%= g %> luni</option>
                        <% } %>
                    </datalist>
                </div>

                <div class="col-12 mt-4">
                    <label class="form-label d-block">Categorie Produs:</label>
                    <div class="btn-group flex-wrap" role="group">
                        <input type="radio" class="btn-check" name="gr_radio" id="rad-toate" value="toate" checked>
                        <label class="btn btn-outline-primary" for="rad-toate">Toate</label>

                        <% if (locals.categoriiMeniu) { %>
                            <% for (let cat of categoriiMeniu) { %>
                                <input type="radio" class="btn-check" name="gr_radio" id="rad-<%- cat %>" value="<%- cat %>">
                                <label class="btn btn-outline-primary" style="text-transform: capitalize;" for="rad-<%- cat %>"><%- cat.replace('_', ' ') %></label>
                            <% } %>
                        <% } %>
                    </div>
                </div>

                <div class="col-md-6 mt-4">
                    <label class="form-label">
                        Preț Maxim: <span id="infoRange" style="color: var(--accent-color); font-weight: bold;">(Selectați o valoare)</span>
                    </label>
                    <div class="d-flex align-items-center">
                        <span>0</span>
                        <input type="range" class="form-range flex-grow-1 mx-2" id="inp-pret" min="0" max="<%= pretMaximDB %>" step="50" value="<%= pretMaximDB %>">
                        <span><%= pretMaximDB %></span>
                    </div>
                </div>

                <div class="col-md-3 mt-4">
                    <label class="form-label d-block">Stare produs:</label>
                    <input type="checkbox" class="btn-check" id="inp-nou" autocomplete="off" checked>
                    <label class="btn btn-outline-secondary w-100" for="inp-nou"><i class="fa-solid fa-box"></i> Doar Produse Noi</label>
                </div>

                <div class="col-md-3 mt-4">
                    <label class="form-label">Compatibilitate (Ctrl+Click)</label>
                    <select id="inp-compatibilitate" class="form-select" multiple size="3">
                        <% for (let comp of compatibilitati) { %>
                            <option value="<%= comp %>"><%= comp %></option>
                        <% } %>
                    </select>
                </div>
            </div>

            <div class="row mt-4 g-2 p-3" style="background-color: rgba(255,255,255,0.05); border-radius: 8px; border: 1px dashed var(--secondary-color);">
                <div class="col-12"><label style="color: var(--accent-color); font-weight: bold;"><i class="fa-solid fa-sort"></i> Sortare Avansată (2 Criterii)</label></div>
                
                <div class="col-md-3">
                    <select id="sort-criteriu1" class="form-select">
                        <option value="nume">Nume Produs</option>
                        <option value="pret">Preț</option>
                        <option value="garantie">Garanție</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select id="sort-criteriu2" class="form-select">
                        <option value="pret">Preț</option>
                        <option value="nume">Nume Produs</option>
                        <option value="garantie">Garanție</option>
                    </select>
                </div>
                <div class="col-md-6 d-flex gap-2">
                    <button id="btn-sort-avansat-asc" class="btn btn-warning w-100"><i class="fa-solid fa-arrow-up-a-z"></i> Crescător</button>
                    <button id="btn-sort-avansat-desc" class="btn btn-warning w-100"><i class="fa-solid fa-arrow-down-z-a"></i> Descrescător</button>
                </div>
            </div>

            <hr class="my-4" style="border-color: var(--primary-color);">

            <div class="row g-2">
                <div class="col-sm-6"><button id="btn-filtrare" class="btn btn-primary w-100"><i class="fa-solid fa-filter"></i> Filtrează</button></div>
                <div class="col-sm-6"><button id="btn-reset" class="btn btn-danger w-100"><i class="fa-solid fa-trash-can"></i> Resetează Filtre</button></div>
                <div class="col-12 mt-3"><button id="btn-calcul" class="btn btn-success w-100"><i class="fa-solid fa-calculator"></i> Calculează Suma Prețurilor</button></div>
            </div>

            <!-- BONUS 10a+10b (Etapa 6): filtrare + sortare pe server, trimise prin fetch() -->
            <div class="row mt-3 g-2 p-3" style="background-color: rgba(255,255,255,0.05); border-radius: 8px; border: 1px dashed var(--accent-color);">
                <div class="col-12"><label style="color: var(--accent-color); font-weight: bold;"><i class="fa-solid fa-server"></i> Filtrare + Sortare pe Server (folosind aceleași filtre de mai sus, prin fetch)</label></div>
                <div class="col-sm-6"><button id="btn-filtrare-server-asc" class="btn btn-outline-info w-100"><i class="fa-solid fa-arrow-up-a-z"></i> Filtrează pe server (Crescător)</button></div>
                <div class="col-sm-6"><button id="btn-filtrare-server-desc" class="btn btn-outline-info w-100"><i class="fa-solid fa-arrow-down-z-a"></i> Filtrează pe server (Descrescător)</button></div>
                <div class="col-12"><small id="status-server" class="text-muted"></small></div>
            </div>
        </section>

        <div class="alert alert-info py-2" style="background-color: var(--bg-color-alt); border-color: var(--primary-color); color: var(--text-color);">
            <i class="fa-solid fa-circle-info text-primary"></i> <span id="statistici-produse">Se încarcă numărul de produse...</span>
        </div>

        <div id="container-produse" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px;">
            
            <% for (let prod of produse) { %>
                <article class="produs" id="artc-<%= prod.id %>" data-id="<%= prod.id %>" style="background-color: var(--bg-color-alt); border: 1px solid var(--secondary-color); border-radius: 8px; padding: 15px; position: relative;">

                    <% /* BONUS 18 (Etapa 6): marcaj "NOU" pentru produsele adaugate recent pe site */ %>
                    <% let esteNouPeSite = (new Date().getTime() - new Date(prod.data_adaugare).getTime()) <= locals.T_PRODUS_NOU_MS; %>
                    <% if (esteNouPeSite) { %>
                        <span class="badge bg-primary" style="position: absolute; top: -8px; right: -8px; z-index: 5; font-size: 0.75em; box-shadow: 0 2px 6px rgba(0,0,0,0.4); transform: rotate(8deg);">
                            <i class="fa-solid fa-star"></i> NOU
                        </span>
                    <% } %>

                    <% if (prod.cel_mai_ieftin) { %>
                        <div class="insigna-ieftin" style="background: linear-gradient(45deg, #2ecc71, #27ae60); color: white; padding: 5px; border-radius: 4px; text-align: center; margin-bottom: 10px; font-weight: bold; text-transform: uppercase;">
                            <i class="fa-solid fa-fire-flame-curved"></i> Cel mai ieftin din categorie!
                        </div>
                    <% } %>
                    
                    <h3 class="nume" style="text-align: center; margin-bottom: 15px;">
                        <a href="/produs/<%= prod.id %>" style="color: var(--primary-color); text-decoration: none;"><%= prod.nume %></a>
                    </h3>
                    
                    <div class="info-produs">
                        <picture style="display: block; width: 100%; text-align: center; margin-bottom: 15px;">
                            <img src="/resurse/imagini/<%= prod.imagine %>" alt="<%= prod.nume %>" style="width: 100%; height: 200px; object-fit: cover; border-radius: 8px;">
                        </picture>
                        
                        <p class="descriere" style="font-size: 0.9em; margin-bottom: 15px; text-align: justify;"><%= prod.descriere %></p>

                        <ul style="list-style-type: none; padding-left: 0; font-size: 0.9em; display: flex; flex-direction: column; gap: 8px;">
                            <li><span style="color: var(--accent-color); font-weight: bold;">Categorie:</span> <span class="val-categorie"><%= prod.categorie.replace('_', ' ') %></span></li>
                            
                            <li>
                                <span style="color: var(--accent-color); font-weight: bold;">Preț:</span> 
                                <% if (locals.oferta && locals.oferta.categorie === prod.categorie) { %>
                                    <% let pretRedus = prod.pret - (prod.pret * locals.oferta.reducere / 100); %>
                                    <del class="text-secondary"><%= prod.pret %></del> 
                                    <span class="val-pret" style="color: #27ae60; font-weight: bold; font-size: 1.1em;"><%= pretRedus.toFixed(2) %></span> RON
                                    <span class="badge bg-danger ms-1"> -<%= locals.oferta.reducere %>%</span>
                                <% } else { %>
                                    <span class="val-pret"><%= prod.pret %></span> RON
                                <% } %>
                            </li>

                            <li><span style="color: var(--accent-color); font-weight: bold;">Garanție:</span> <span class="val-garantie"><%= prod.garantie_luni %></span> luni</li>
                            <li><span style="color: var(--accent-color); font-weight: bold;">Culoare:</span> <span class="val-culoare"><%= prod.culoare %></span></li>
                            <li><span style="color: var(--accent-color); font-weight: bold;">Compatibilitate:</span> <span class="val-compatibilitate"><%= prod.compatibilitate %></span></li>
                            <li><span style="color: var(--accent-color); font-weight: bold;">Stare:</span> <span class="val-nou"><%= prod.nou ? 'Produs Nou' : 'Resigilat' %></span></li>
                            
                            <% 
                                let dataFormatata = new Intl.DateTimeFormat('ro-RO', { 
                                    weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' 
                                }).format(new Date(prod.data_adaugare));
                            %>
                            <li>
                                <span style="color: var(--accent-color); font-weight: bold;">Adăugat la:</span> 
                                <time class="val-data" datetime="<%= prod.data_adaugare %>"><%= dataFormatata %></time>
                            </li>
                        </ul>

                        <div class="mt-3 text-center">
                            <button class="btn btn-sm btn-outline-info btn-comparare w-100" data-id="<%= prod.id %>" data-nume="<%= prod.nume %>">
                                <i class="fa-solid fa-scale-balanced"></i> Compară
                            </button>
                        </div>

                        <!-- BONUS 6 (Etapa 6): 3 butoane cu iconițe (fără text) pentru fiecare produs -->
                        <div class="mt-2 d-flex justify-content-center gap-2 butoane-bonus6" data-id="<%= prod.id %>">
                            <button type="button" class="btn btn-sm btn-outline-warning btn-pastreaza"
                                title="Păstrează acest produs mereu vizibil, chiar dacă filtrarea l-ar ascunde">
                                <i class="fa-solid fa-thumbtack"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary btn-ascunde-temp"
                                title="Ascunde temporar produsul (revine la o nouă filtrare/sortare/resetare)">
                                <i class="fa-solid fa-eye-slash"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger btn-ascunde-sesiune"
                                title="Ascunde produsul pe durata sesiunii curente (acest tab)">
                                <i class="fa-solid fa-ban"></i>
                            </button>
                        </div>
                    </div>
                </article>
            <% } %>

        </div>

        <!-- BONUS 5 (Etapa 6): Paginare - se generează linkuri/butoane pentru fiecare pagină -->
        <nav class="mt-4 d-flex justify-content-center" aria-label="Paginare produse">
            <ul id="paginare-produse" class="pagination"></ul>
        </nav>

        <!-- BONUS 11 (Etapa 6): Modal box cu datele produsului, deschis la click pe container -->
    <div class="modal fade" id="modalProdus" tabindex="-1" aria-labelledby="modalProdusLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content" style="background-color: var(--bg-color-alt); color: var(--text-color); border: 1px solid var(--primary-color);">
                <div class="modal-header" style="border-color: var(--secondary-color);">
                    <h5 class="modal-title" id="modalProdusLabel" style="color: var(--primary-color);">Detalii produs</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Închide"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-4">
                        <div class="col-md-5 text-center">
                            <img id="modal-img" src="" alt="" style="max-width: 100%; max-height: 260px; object-fit: contain; border-radius: 10px;">
                        </div>
                        <div class="col-md-7">
                            <p id="modal-descriere" style="text-align: justify;"></p>
                            <ul style="list-style: none; padding-left: 0; display: flex; flex-direction: column; gap: 6px;">
                                <li><strong style="color: var(--accent-color);">Categorie:</strong> <span id="modal-categorie"></span></li>
                                <li><strong style="color: var(--accent-color);">Preț:</strong> <span id="modal-pret"></span> RON</li>
                                <li><strong style="color: var(--accent-color);">Garanție:</strong> <span id="modal-garantie"></span> luni</li>
                                <li><strong style="color: var(--accent-color);">Culoare:</strong> <span id="modal-culoare"></span></li>
                                <li><strong style="color: var(--accent-color);">Compatibilitate:</strong> <span id="modal-compatibilitate"></span></li>
                                <li><strong style="color: var(--accent-color);">Stare:</strong> <span id="modal-nou"></span></li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="border-color: var(--secondary-color);">
                    <a id="modal-link-produs" href="#" class="btn btn-primary">Vezi pagina completă a produsului</a>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Închide</button>
                </div>
            </div>
        </div>
    </div>
    </main>

    <%- include('../fragmente/footer') %>
</body>
</html>