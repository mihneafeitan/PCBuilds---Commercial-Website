<!DOCTYPE html>
<html lang="ro">
<head>
    <title>Comparare - PCBuilds</title>
    <%- include('../fragmente/head') %>
</head>
<body id="top" style="background-color: var(--bg-color-main); color: var(--text-color);">
    <%- include('../fragmente/header') %>

    <main class="container my-5" style="padding: 2rem var(--page-padding);">
        <h2 class="text-center mb-4" style="color: var(--primary-color);"><i class="fa-solid fa-scale-balanced"></i> Comparare Produse</h2>
        
        <div class="table-responsive shadow-lg rounded">
            <table class="table table-bordered text-center align-middle" data-bs-theme="dark" style="background-color: var(--bg-color-alt);">
                <thead style="background-color: var(--primary-color); color: white;">
                    <tr>
                        <th style="width: 20%; font-size: 1.2rem;">Specificație</th>
                        <th style="width: 40%; font-size: 1.2rem; color: var(--accent-color);"><%= p1.nume %></th>
                        <th style="width: 40%; font-size: 1.2rem; color: var(--accent-color);"><%= p2.nume %></th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold" style="color: var(--accent-color);">Imagine</td>
                        <td><img src="/resurse/imagini/<%= p1.imagine %>" alt="<%= p1.nume %>" style="max-height: 150px; border-radius: 8px;"></td>
                        <td><img src="/resurse/imagini/<%= p2.imagine %>" alt="<%= p2.nume %>" style="max-height: 150px; border-radius: 8px;"></td>
                    </tr>
                    <tr>
                        <td class="fw-bold" style="color: var(--accent-color);">Preț</td>
                        <td class="fs-4 fw-bold text-success"><%= p1.pret %> RON</td>
                        <td class="fs-4 fw-bold text-success"><%= p2.pret %> RON</td>
                    </tr>
                    <tr>
                        <td class="fw-bold" style="color: var(--accent-color);">Categorie</td>
                        <td style="text-transform: capitalize;"><%= p1.categorie.replace('_', ' ') %></td>
                        <td style="text-transform: capitalize;"><%= p2.categorie.replace('_', ' ') %></td>
                    </tr>
                    <tr>
                        <td class="fw-bold" style="color: var(--accent-color);">Garanție</td>
                        <td><%= p1.garantie_luni %> luni</td>
                        <td><%= p2.garantie_luni %> luni</td>
                    </tr>
                    <tr>
                        <td class="fw-bold" style="color: var(--accent-color);">Culoare</td>
                        <td><%= p1.culoare %></td>
                        <td><%= p2.culoare %></td>
                    </tr>
                    <tr>
                        <td class="fw-bold" style="color: var(--accent-color);">Compatibilitate</td>
                        <td><%= p1.compatibilitate %></td>
                        <td><%= p2.compatibilitate %></td>
                    </tr>
                    <tr>
                        <td class="fw-bold" style="color: var(--accent-color);">Stare</td>
                        <td><%= p1.nou ? 'Produs Nou' : 'Resigilat' %></td>
                        <td><%= p2.nou ? 'Produs Nou' : 'Resigilat' %></td>
                    </tr>
                </tbody>
            </table>
        </div>
        
        <div class="text-center mt-4">
            <button class="btn btn-outline-danger btn-lg" onclick="window.close()"><i class="fa-solid fa-xmark"></i> Închide Fereastra</button>
        </div>
    </main>

    <%- include('../fragmente/footer') %>
</body>
</html>